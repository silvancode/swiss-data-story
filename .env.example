# Prioritaetenliste, kommagetrennt: groq, ollama, hf, openai, gemini
# Beispiel Entwicklung (gratis): AI_PROVIDER=groq,ollama
# Beispiel Produktion:           AI_PROVIDER=gemini
# Leer/none = automatisch nach vorhandenen Keys (Gratis-Provider zuerst)
AI_PROVIDER=none

# Groq: gratis, 1'000 Requests/Tag fuer das 70B-Modell (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama: lokal, komplett gratis (ollama serve muss laufen)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Hugging Face Inference Providers (kleines Gratis-Kontingent)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Bezahlte Provider (Produktion)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Timeout pro AI-Aufruf in Sekunden (lokale Modelle brauchen laenger)
AI_TIMEOUT=120

MAX_TOPICS=5
MAX_DATASETS_PER_TOPIC=8
MIN_STORY_SCORE=0.55
MAX_STORY_SIMILARITY=0.86
HISTORY_LIMIT=40
